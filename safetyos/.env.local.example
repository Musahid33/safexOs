# SafetyOS environment configuration — COPY to .env.local and fill in.
# NEVER commit the real .env.local (it is git-ignored).

# --- Supabase project (public-by-design values) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# --- Mode ----------------------------------------------------------
# false = LIVE MODE — Supabase auth + PostgreSQL (active)
# true  = demo mode — in-memory mock data, no Supabase needed
NEXT_PUBLIC_DEMO_MODE=false

# --- Vercel (only for `vercel` CLI / Edge runtime OIDC) ------------
# Prefer `vercel login` or the GitHub Actions VERCEL_TOKEN secret.
# Do NOT paste a token into chat or commit it.
# VERCEL_OIDC_TOKEN=
