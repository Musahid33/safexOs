{
  "name": "safex-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Original Safex PWA, with the separate SafetyOS application in safetyos/",
  "scripts": {
    "dev": "node scripts/serve-safex.mjs",
    "build": "npm --prefix safex-src run build",
    "test": "node --test scripts/test-deployment.mjs && npm --prefix safex-src test",
    "check:generated": "node scripts/check-generated.mjs",
    "dev:safetyos": "npm --prefix safetyos run dev",
    "build:safetyos": "npm --prefix safetyos run build",
    "typecheck:safetyos": "npm --prefix safetyos run typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
